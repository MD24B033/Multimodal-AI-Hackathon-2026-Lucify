# Copy to .env and fill in. Never commit the real .env.

# Local Postgres, piece by piece.
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=study_companion

# A managed Postgres (Neon, Railway, Supabase) gives one URL instead. When this is set
# it wins over the DB_* settings above. postgres:// and postgresql:// both work.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Required. Get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Access control. Comma separated `key:Name` pairs — one per person.
# Leave empty to run fully open (local dev only).
ACCESS_KEYS=k_alice_change_me:Alice,k_bob_change_me:Bob

# Optional self-hosted Redis. Leave empty unless you actually run one; Upstash below
# is the hosted path, and in-process events are the fallback for a single instance.
REDIS_URL=

# Comma separated. Add your deployed frontend origin here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Raise these if you upgrade the Groq tier.
TOKENS_PER_MINUTE=8000

# Optional: Upstash Redis (REST). Used to share one token budget across the API
# and the evaluation harness so they stop starving each other.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Live progress (ingestion, background generation) travels through Upstash so it
# survives across processes and across a Railway restart. REST cannot SUBSCRIBE, so
# events go into a capped Redis stream and are read forward from a cursor.
USE_UPSTASH_FOR_EVENTS=true
SHARE_TOKEN_BUDGET=true

# Poll interval while a job is producing events, and the ceiling it backs off to
# when nothing is happening. One command per poll, per channel, however many
# browser tabs are watching.
UPSTASH_POLL_SECONDS=1.0
UPSTASH_IDLE_POLL_SECONDS=6.0

# A browser's EventSource reconnects by itself, so streams are recycled rather than
# held open forever.
SSE_MAX_SECONDS=900
SSE_RETRY_MS=3000

# Where uploads, extracted figures and audio live. On a platform with an ephemeral
# filesystem point this at a mounted volume, or citations stop opening after a deploy.
# STORAGE_DIR=/app/storage

# Preview deployments get generated hostnames; a regex covers them all.
# CORS_ORIGIN_REGEX=https://lucify-.*\.vercel\.app
